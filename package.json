{
  "name": "dsh-model-dispatch",
  "version": "1.1.1",
  "description": "模型分工（Model Dispatch）— 评估子任务的类型与难度，按用户配置把任务路由到不同模型并通过 spawn 子代理执行。独立任务并行、重复任务合并、歧义任务先向用户确认。DSH 静态插件，配置持久化。",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "model-dispatch",
    "model-routing",
    "subagent",
    "plugin"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
